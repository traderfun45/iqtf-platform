generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// User Model (อัปเดต)
// ========================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          Role      @default(USER)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  trades        Trade[]
  orders        Order[]
  alerts        Alert[]
  strategies    Strategy[]
  sessions      Session[]
  passwordResets PasswordReset[]
  portfolio     Portfolio?

  @@map("users")
}

// ========================================
// Portfolio Model (พอร์ตโฟลิโอ)
// ========================================
model Portfolio {
  id            String    @id @default(cuid())
  userId        String    @unique
  balance       Float     @default(10000.0) // เงินเริ่มต้น
  equity        Float     @default(10000.0)
  totalPnL      Float     @default(0.0)
  totalPnLPercent Float   @default(0.0)
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings      Holding[]

  @@map("portfolios")
}

// ========================================
// Holding Model (การถือครอง)
// ========================================
model Holding {
  id            String    @id @default(cuid())
  portfolioId   String
  symbol        String
  quantity      Float
  averagePrice  Float
  currentPrice  Float?
  value         Float?
  pnl           Float?
  pnlPercent    Float?
  updatedAt     DateTime  @updatedAt

  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
  @@map("holdings")
}

// ========================================
// Order Model (คำสั่งซื้อขาย)
// ========================================
model Order {
  id            String    @id @default(cuid())
  userId        String
  symbol        String
  side          OrderSide
  type          OrderType
  quantity      Float
  price         Float?
  stopPrice     Float?
  takeProfit    Float?
  status        OrderStatus @default(PENDING)
  executedQty   Float     @default(0.0)
  avgPrice      Float?
  fee           Float     @default(0.0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  executedAt    DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([symbol, createdAt])
  @@map("orders")
}

// ========================================
// Trade Model (บันทึกการซื้อขายที่สำเร็จ)
// ========================================
model Trade {
  id            String    @id @default(cuid())
  userId        String
  orderId       String?
  symbol        String
  side          Side
  quantity      Float
  price         Float
  fee           Float     @default(0.0)
  pnl           Float?
  status        TradeStatus @default(OPEN)
  createdAt     DateTime  @default(now())
  closedAt      DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol])
  @@map("trades")
}

// ========================================
// Existing Models (Strategy, Alert, Session, PasswordReset)
// ========================================
model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isActive    Boolean  @default(true)
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])

  @@map("strategies")
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  condition String
  isActive  Boolean  @default(true)
  triggered Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("alerts")
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  refreshToken  String    @unique
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revoked       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordReset {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  expiresAt     DateTime
  used          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ========================================
// Enums
// ========================================
enum Role {
  USER
  ADMIN
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum Side {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

// ========================================
// Strategy Model (อัปเดต)
// ========================================
model Strategy {
  id            String    @id @default(cuid())
  userId        String
  name          String
  description   String?
  type          StrategyType @default(CUSTOM)
  isActive      Boolean   @default(true)
  config        Json      // เก็บเงื่อนไขทั้งหมด
  status        StrategyStatus @default(DRAFT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastRunAt     DateTime?
  totalTrades   Int       @default(0)
  winRate       Float     @default(0.0)
  totalPnL      Float     @default(0.0)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyLogs  StrategyLog[]

  @@map("strategies")
}

// ========================================
// Strategy Log (บันทึกการทำงาน)
// ========================================
model StrategyLog {
  id            String    @id @default(cuid())
  strategyId    String
  symbol        String
  action        String    // BUY, SELL, HOLD
  price         Float
  quantity      Float?
  reason        String?
  timestamp     DateTime  @default(now())

  strategy      Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, timestamp])
  @@map("strategy_logs")
}

// ========================================
// Enums (เพิ่ม)
// ========================================
enum StrategyType {
  MA_CROSSOVER      // Moving Average Crossover
  RSI_OVERSOLD      // RSI Oversold/Overbought
  MACD_SIGNAL       // MACD Signal
  BOLLINGER_BANDS   // Bollinger Bands
  CUSTOM            // ผู้ใช้กำหนดเอง
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  PAUSED
  STOPPED
}

// ========================================
// Backtest Model (บันทึกผลการทดสอบ)
// ========================================
model Backtest {
  id            String    @id @default(cuid())
  userId        String
  strategyId    String?
  name          String
  symbol        String
  startDate     DateTime
  endDate       DateTime
  initialCapital Float   @default(10000.0)
  finalCapital   Float
  totalReturn   Float
  totalReturnPercent Float
  totalTrades   Int
  winRate       Float
  avgWin        Float
  avgLoss       Float
  maxDrawdown   Float
  sharpeRatio   Float
  trades        Json      // เก็บรายการซื้อขายทั้งหมด
  equityCurve   Json      // เก็บมูลค่าพอร์ตแต่ละวัน
  config        Json      // เก็บ config ที่ใช้
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy      Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("backtests")
}

// ========================================
// OHLCV Data (ราคาย้อนหลัง) - เตรียมไว้
// ========================================
model OHLCV {
  id            String    @id @default(cuid())
  symbol        String
  timeframe     String    // 1m, 5m, 15m, 1h, 4h, 1d
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  timestamp     DateTime

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@map("ohlcv")
}

// ========================================
// Asset Model (สินทรัพย์ทั้งหมด)
// ========================================
model Asset {
  id            String    @id @default(cuid())
  symbol        String    @unique
  name          String
  type          AssetType
  exchange      String?
  sector        String?
  currency      String    @default("USD")
  minQuantity   Float     @default(0.001)
  maxQuantity   Float     @default(1000)
  lotSize       Float     @default(0.001)
  tickSize      Float     @default(0.01)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  prices        AssetPrice[]
  orders        Order[]
  holdings      Holding[]
  strategies    Strategy[]

  @@map("assets")
}

// ========================================
// Asset Price (ราคาสินทรัพย์)
// ========================================
model AssetPrice {
  id            String    @id @default(cuid())
  assetId       String
  symbol        String
  price         Float
  bid           Float?
  ask           Float?
  high          Float?
  low           Float?
  volume        Float?
  change        Float?
  changePercent Float?
  timestamp     DateTime  @default(now())

  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, timestamp])
  @@map("asset_prices")
}

// ========================================
// Enums (เพิ่ม)
// ========================================
enum AssetType {
  CRYPTO
  STOCK
  FOREX
  COMMODITY
  INDEX
  FUTURES
  SPOT
  ETF
  BOND
}
