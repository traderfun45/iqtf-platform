# ====================
# Database
# ====================
DATABASE_URL="postgresql://user:password@localhost:5432/iqtf"

# ====================
# API Server
# ====================
API_PORT=3000
API_HOST=0.0.0.0

# ====================
# JWT Authentication
# ====================
JWT_SECRET="iqtf-super-secret-key-change-me-2026"
JWT_REFRESH_SECRET="iqtf-refresh-secret-key-change-me-2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ====================
# Email Service (For Forgot Password)
# ====================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@iqtf-platform.com"

# ====================
# Frontend URL (For email links)
# ====================
FRONTEND_URL="http://localhost:3000"

# ====================
# Redis (For rate limiting & sessions)
# ====================
REDIS_URL="redis://localhost:6379"

# ====================
# WebSocket
# ====================
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000


